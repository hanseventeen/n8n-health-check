# Copy to .env (git-ignored) if you want these values handy. No script reads this file:
# the n8n workflow keeps the key in an n8n "n8n API" credential.

# Base URL n8n uses to call its own API. Inside Docker this is the container port.
N8N_API_BASE_URL=http://localhost:5678/api/v1

# A key with only workflow:read, execution:read and securityAudit:generate.
N8N_API_KEY=your-read-only-api-key
